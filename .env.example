# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Connection string for the dashboard's OWN database.
#
# This database stores projects, providers, encrypted credentials and collected
# metrics. It is NOT one of the databases you are monitoring -- those are
# registered from inside the dashboard and reached only by the collectors.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_observability"

# Set to "true" when the dashboard database requires TLS (most managed
# providers do). Leave "false" for a local instance.
DATABASE_SSL="false"

# Encrypts registered provider API keys at rest (AES-256-GCM).
#
# Generate with:  npm run generate:key
#
# LOSING THIS KEY MAKES EVERY STORED CREDENTIAL UNRECOVERABLE. Back it up
# separately from the database, and use a different key per environment.
CREDENTIAL_ENCRYPTION_KEY=""

# Only during a key rotation: the old key, accepted for decryption so existing
# credentials keep working while they are re-encrypted. Otherwise leave empty.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=""
